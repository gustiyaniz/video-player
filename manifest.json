{
  "id": "./index.html",
  "name": "FydeOS Video Player",
  "short_name": "Video Player",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "./icon/videoplayer.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/webm": [".webm"],
        "video/ogg": [".ogv", ".ogg"],
        "video/x-matroska": [".mkv"],
        "video/x-msvideo": [".avi"],
        "video/mpeg": [".mpeg", ".mpg"],
        "video/quicktime": [".mov"],
        "video/mp2t": [".ts", ".mts", ".m2ts"]
      }
    }
  ]
}
