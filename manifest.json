{
  "name": "FydeOS Video Player",
  "short_name": "Video Player",
  "start_url": "./index.html",
  "display": "standalone",
  "icons": [
    {
      "src": "./icon/videoplayer.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "video/mp4": [".mp4"],
        "video/webm": [".webm"],
        "video/ogg": [".ogv"],
        "video/x-matroska": [".mkv"],
        "video/avi": [".avi"],
        "video/mpeg": [".mpeg", ".mpg"],
        "video/quicktime": [".mov"]
      }
    }
  ]
}
